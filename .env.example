# DiningOut Editorial Scraper Tool — Environment Variables
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.

# Reddit — no API key needed! Uses public .json endpoints.

# Email — SMTP (e.g., Gmail app password)
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_HOST=smtp.gmail.com

# TikTok (optional — grab ms_token from browser cookies for direct scraping)
# TIKTOK_MS_TOKEN=your_ms_token_cookie

# Email — SendGrid (alternative to SMTP — https://sendgrid.com)
# SENDGRID_API_KEY=your_sendgrid_api_key
